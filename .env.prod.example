# =====================================================================================================================
# Aircraft Failure Prediction Platform — PRODUCTION configuration template (safe placeholders only)
# =====================================================================================================================
# Copy to `.env.prod` (never commit it) and replace every <CHANGE_ME...>. Used by docker-compose.prod.yml:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
# Generate secrets locally, e.g.:  openssl rand -base64 48
# The database is aircraft_predict_db; aircraft_app is always refused.

# ---------- PostgreSQL target (the "db" service on the internal network) ----------
DB_NAME=aircraft_predict_db
DB_HOST=db
DB_PORT=5432
# Schema owner (the postgres image's POSTGRES_USER): initialises schema and seed. Not used by the running API or ML.
DB_USER=postgres
DB_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>

# ---------- Dedicated least-privilege roles (created on first start by tools/docker/initdb/00-roles.sh) ----------
# API: data access (SELECT/INSERT/UPDATE/DELETE), no DDL.
DB_APP_USER=afp_predict_api
API_USER_PASSWORD=<CHANGE_ME>
# ML read-only role.
ML_READER_USER=afp_predict_ml_reader
ML_READER_PASSWORD=<CHANGE_ME>
# ML/ETL writer role (predictions, anomaly results, model registry, pipeline runs).
ETL_WRITER_USER=afp_predict_etl_writer
ETL_WRITER_PASSWORD=<CHANGE_ME>
# Spark ETL ingest role (telemetry inserts, import status). Created even when the ETL is not deployed.
INGEST_USER=afp_predict_ingest
INGEST_PASSWORD=<CHANGE_ME>

# ---------- JWT ----------
# HMAC-SHA256 signing key, base64, at least 32 bytes.
Jwt__SigningKey=<CHANGE_ME_BASE64_AT_LEAST_32_BYTES>
Jwt__Issuer=AircraftFailurePrediction
Jwt__Audience=AircraftFailurePrediction
# Lifetimes: the API reads Jwt:ExpiryMinutes (access token) and Auth:RefreshTokenDays (refresh token).
Jwt__ExpiryMinutes=60
Auth__RefreshTokenDays=7

# ---------- Environment ----------
ASPNETCORE_ENVIRONMENT=Production
AFP_ENVIRONMENT=operational
# Schema changes are applied deliberately (tools/db), never at API startup.
DB_AUTO_MIGRATE=false

# ---------- MinIO (Bronze raw uploads + model artifact mirror; not part of this compose file) ----------
# MINIO_ENDPOINT=http://<minio-host>:9000
# MINIO_ACCESS_KEY=<CHANGE_ME>
# MINIO_SECRET_KEY=<CHANGE_ME>
# MINIO_BRONZE_BUCKET=bronze
# MINIO_BRONZE_PREFIX=telemetry/
