{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AppDb": ""
  },
  "Jwt": {
    "Issuer": "AircraftFailurePrediction",
    "Audience": "AircraftFailurePrediction.Web",
    "SigningKey": "",
    "ExpiryMinutes": 60
  },
  "Auth": {
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 15,
    "PasswordResetTokenMinutes": 30,
    "PasswordResetUrl": "http://localhost:5173/reset-password"
  },
  "Email": {
    "Mode": "Pickup",
    "From": "no-reply@afp.local"
  },
  "Prediction": {
    "HorizonDays": 30
  },
  "TelemetryImport": {
    "MaxFileBytes": 209715200,
    "BatchSize": 5000,
    "MaxStoredRejectedRows": 10000
  },
  "RateLimiting": {
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60,
    "GlobalPermitLimit": 600,
    "GlobalWindowSeconds": 60
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  }
}
