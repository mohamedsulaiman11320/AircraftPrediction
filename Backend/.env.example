# Backend configuration reference (EXAMPLE ONLY — never commit real values).
#
# Database target, role credentials, JWT key and shared ML settings live in ONE file: the repository-root `.env`
# (template: ../.env.example). The API loads it at startup; real environment variables take precedence.
#
# Optional API-only settings (add to the root .env or set as environment variables; `__` = section separator):

# Explicit connection string (overrides DB_* composition; still validated: must target DB_NAME, never aircraft_app).
# ConnectionStrings__AppDb=Host=localhost;Port=5432;Database=aircraft_predict_db;Username=afp_predict_api;Password=CHANGE_ME

# Password reset links point at the frontend.
Auth__PasswordResetUrl=http://localhost:5173/reset-password

# Email: "Pickup" writes messages to %LOCALAPPDATA%\AircraftFailurePrediction\mail (development); "Smtp" sends them.
Email__Mode=Pickup
# Email__SmtpHost=smtp.example.com
# Email__SmtpPort=587
# Email__SmtpUsername=
# Email__SmtpPassword=

# Where original CSV uploads are preserved (default %LOCALAPPDATA%\AircraftFailurePrediction\imports).
# TelemetryImport__StorageDirectory=D:\afp\imports

# CORS origin(s) for the frontend.
# Cors__AllowedOrigins__0=http://localhost:5173

# Used only by the one-off `bootstrap-admin` command; set in the shell, never in a file, and clear it afterwards.
# AFP_BOOTSTRAP_ADMIN_PASSWORD=
