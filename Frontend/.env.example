# Copy to .env (or .env.local) and adjust. Only variables prefixed with VITE_ are exposed to the browser.

# Base URL of the ASP.NET Core backend (no trailing slash). All calls go to {base}/api/v1/...
VITE_API_BASE_URL=http://localhost:5080

# When "true" the UI serves fictional fixtures from src/demo/ instead of calling the API,
# and shows a persistent "DEMO DATA - not from the live API" banner. Leave false for real use.
VITE_DEMO_MODE=false
