# Aircraft Failure Prediction Platform - ML subsystem configuration (EXAMPLE ONLY - no real secrets).
# Copy to ml/.env (git-ignored) or set the variables in your environment.
# Precedence: real environment variables > ml/.env (or AFP_ML_ENV_FILE=<path> / --env-file)
#             > the repository-root .env (parent of ml/). Files never override earlier sources.

# --- Database (PostgreSQL 17, database aircraft_predict_db) ------------------------------------
# The target database. aircraft_app is PROTECTED and is always refused.
DB_NAME=aircraft_predict_db
# Usually these come from the repository-root .env shared with the backend; set them here only to
# override. When AFP_ML_READER_DSN / AFP_ML_WRITER_DSN are unset, the DSNs are composed as
#   postgresql://<user>:<password>@DB_HOST:DB_PORT/DB_NAME   (user/password URL-encoded)
# DB_HOST=localhost
# DB_PORT=5432
# Read-only role: SELECT on aircraft, telemetry_record, maintenance_log, model_version,
# pipeline_run, aircraft_anomaly_result, aircraft_risk_prediction, risk_status.
# ML_READER_USER=<reader-role>
# ML_READER_PASSWORD=<password>
# Writer role: reader + INSERT on aircraft_anomaly_result, aircraft_risk_prediction, model_version,
# pipeline_run and column-restricted UPDATE on pipeline_run / model_version.
# ETL_WRITER_USER=<writer-role>
# ETL_WRITER_PASSWORD=<password>
# Optional explicit DSNs (highest precedence). Their database must equal DB_NAME.
# AFP_ML_READER_DSN=postgresql://<reader-role>:<password>@localhost:5432/aircraft_predict_db
# AFP_ML_WRITER_DSN=postgresql://<writer-role>:<password>@localhost:5432/aircraft_predict_db
# Extra database names that must never be used (comma list, case-insensitive; aircraft_app is always included).
# DB_FORBIDDEN_NAMES=
# Connection timeout in seconds.
AFP_DB_CONNECT_TIMEOUT=10

# --- Model artifacts ---------------------------------------------------------------------------
# Must be OUTSIDE source control. Default when unset: %LOCALAPPDATA%\AircraftFailurePrediction\models
# AFP_MODEL_DIR=C:\Users\<you>\AppData\Local\AircraftFailurePrediction\models

# --- Failure prediction ------------------------------------------------------------------------
# Horizon (days) for "verified unscheduled maintenance within the next N days".
AFP_PREDICTION_HORIZON_DAYS=30
# Readiness gate (failure prediction stays Blocked until ALL are met).
AFP_READINESS_MIN_POSITIVE_LABELS=30
AFP_READINESS_MIN_AIRCRAFT_WITH_POSITIVES=5
AFP_READINESS_MIN_LABEL_MONTHS=6
AFP_READINESS_MIN_NEGATIVE_EXAMPLES=200
AFP_READINESS_MIN_SPLIT_POSITIVES=5
# true = only maintenance_log rows with actual_failure_confirmed = true count as labels.
# false (default) = verified Unscheduled events count unless actual_failure_confirmed = false.
AFP_LABEL_REQUIRE_CONFIRMED_FAILURE=false
# Set to true ONLY after the domain owner has signed off the label definition
# (verified Unscheduled maintenance within the horizon). Until then readiness stays Blocked.
ML_LABEL_DEFINITION_CONFIRMED=false
# Comma-separated failure codes in scope. Recorded in the audit and model metadata for traceability;
# NOT used for filtering yet (maintenance_log has no failure_code column).
ML_FAILURE_CODES=
# Calibration acceptance criteria (on the held-out test split).
AFP_CALIBRATION_MAX_ECE=0.10
AFP_CALIBRATION_MIN_TEST_POSITIVES=10

# --- Anomaly detection (Isolation Forest) ------------------------------------------------------
AFP_IF_CONTAMINATION=0.01
AFP_IF_N_ESTIMATORS=200
# Number of PREVIOUS readings per aircraft/sensor used for rolling features.
AFP_FEATURE_WINDOW=6
# Hours of earlier telemetry loaded as context when scoring incrementally.
AFP_SCORING_CONTEXT_HOURS=24
AFP_RANDOM_SEED=42

# --- Descriptive risk indicator ----------------------------------------------------------------
AFP_RISK_WINDOW_DAYS=7
AFP_RISK_RECENCY_HOURS=48
# Anomaly RATE in the window vs. the rate on the training data (IF flags ~contamination of normal data).
AFP_RISK_ELEVATED_RATE_MULTIPLIER=2.0
AFP_RISK_HIGH_RATE_MULTIPLIER=5.0
# Absolute minimum anomaly counts for Elevated / High, and minimum readings in the window.
AFP_RISK_ELEVATED_ANOMALY_COUNT=3
AFP_RISK_HIGH_ANOMALY_COUNT=10
AFP_RISK_MIN_READINGS=36

# --- Dataset audit -----------------------------------------------------------------------------
# A gap between consecutive readings of one aircraft/sensor larger than this is reported.
AFP_AUDIT_GAP_MINUTES=60

# --- Worker ------------------------------------------------------------------------------------
AFP_WORKER_POLL_SECONDS=15

# --- Logging -----------------------------------------------------------------------------------
AFP_LOG_LEVEL=INFO
