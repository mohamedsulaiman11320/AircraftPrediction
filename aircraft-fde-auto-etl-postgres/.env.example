# Aircraft FDE ETL configuration (EXAMPLE - placeholders only). Copy to .env.
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_REGION=us-east-1
HADOOP_AWS_VERSION=3.5.0

# Local Windows PostgreSQL reached from the container (Docker Desktop: host.docker.internal).
APP_DB_HOST=host.docker.internal
APP_DB_PORT=5432
APP_DB_NAME=aircraft_predict_db
# Same role/password as INGEST_USER / INGEST_PASSWORD in the application's root .env.
APP_DB_USER=afp_predict_ingest
APP_DB_PASSWORD=CHANGE_ME
# Databases the ETL must never write to.
APP_DB_FORBIDDEN_NAMES=aircraft_app
APP_DATA_SOURCE=RAW_JSON_BRONZE
# Unknown tail numbers become placeholder aircraft (model/manufacturer below) to be completed in the app.
AUTO_REGISTER_AIRCRAFT=true
PLACEHOLDER_AIRCRAFT_MODEL=Unknown
PLACEHOLDER_AIRCRAFT_MANUFACTURER=Unknown
PLACEHOLDER_AIRCRAFT_FLEET_GROUP=Unassigned
