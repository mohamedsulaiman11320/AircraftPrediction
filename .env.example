# =====================================================================================================
# Aircraft Failure Prediction Platform — local configuration (EXAMPLE, safe placeholders only)
# =====================================================================================================
# Copy to `.env` in this folder (git-ignored) and replace every CHANGE_ME. Read by:
#   * the API (Backend/src/AFP.Api, loaded at startup; real environment variables take precedence)
#   * dotnet ef (design-time factory), tools/db/*.ps1 scripts, and the Python ML package (ml/afp_ml)
# Generate a strong secret in PowerShell (do not paste it into chats, tickets or logs):
#   $b = New-Object byte[] 36; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b) -replace '[+/=]','x'

# ---------- PostgreSQL target (isolated database; aircraft_app is protected and always refused) ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aircraft_predict_db
# Optional: the ISOLATED development (synthetic) database shown read-only to the Data Engineer
# (GET/POST /api/v1/development). Must differ from DB_NAME; aircraft_app is always refused.
# Its ML worker runs with: AFP_ML_ENV_FILE=.env.synthetic python -m afp_ml worker
# DEV_DB_NAME=aircraft_predict_db_synth
# Extra database names to refuse (comma-separated). aircraft_app is always refused.
DB_FORBIDDEN_NAMES=aircraft_app
# Superuser used ONLY by tools/db/provision-database.ps1 (its password is prompted, never stored here).
DB_SUPERUSER=postgres
# Optional: full path to psql.exe if it is not on PATH.
PSQL_PATH=C:\Program Files\PostgreSQL\17\bin\psql.exe

# ---------- Dedicated least-privilege roles (distinct from any roles used by other databases) ----------
# Schema owner: applies migrations and reference seeds. Never used by the running API or ML.
DB_USER=afp_predict_owner
DB_PASSWORD=CHANGE_ME
# API role: data access (SELECT/INSERT/UPDATE/DELETE), no DDL.
DB_APP_USER=afp_predict_api
API_USER_PASSWORD=CHANGE_ME
# ML read-only role: telemetry, aircraft, maintenance labels, model/prediction metadata.
ML_READER_USER=afp_predict_ml_reader
ML_READER_PASSWORD=CHANGE_ME
# ETL/ML writer role: inserts predictions, anomaly results, model registry rows, pipeline runs.
ETL_WRITER_USER=afp_predict_etl_writer
ETL_WRITER_PASSWORD=CHANGE_ME
# ETL ingest role (Spark): inserts telemetry, updates import status only. Used by aircraft-fde-auto-etl-postgres.
INGEST_USER=afp_predict_ingest
INGEST_PASSWORD=CHANGE_ME

# ---------- MinIO bronze storage (raw JSON uploads; MinIO runs in Docker) ----------
# Upload-only MinIO identity for the API (never the MinIO root account).
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=afp-api-uploader
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BRONZE_BUCKET=bronze
MINIO_BRONZE_PREFIX=telemetry/
# Maximum raw JSON upload size in bytes (default 50 MB).
RAW_UPLOAD_MAX_BYTES=52428800

# ---------- Controlled database changes ----------
# provision-database.ps1 creates the database only when true (it never drops anything).
DB_AUTO_CREATE=false
# true = the API applies pending migrations at startup as DB_USER. Keep false; use tools/db/apply-migrations.ps1.
DB_AUTO_MIGRATE=false

# ---------- API secrets ----------
# JWT HMAC-SHA256 signing key, at least 32 bytes.
Jwt__SigningKey=CHANGE_ME_TO_AT_LEAST_32_RANDOM_BYTES

# ---------- ML: label definition and failure prediction ----------
# Prediction horizon in days, shared by the API and the ML pipeline.
AFP_PREDICTION_HORIZON_DAYS=30
# Set true ONLY after the maintenance/engineering owner has signed off which events count as genuine failures.
# Until then supervised failure training stays BLOCKED.
ML_LABEL_DEFINITION_CONFIRMED=false
# Comma-separated failure codes that represent genuine failure events (from the domain owner; see docs/FAILURE_DATA_PLAN.md).
ML_FAILURE_CODES=
# true = only maintenance events with actual_failure_confirmed = true count as labels.
AFP_LABEL_REQUIRE_CONFIRMED_FAILURE=true

# ---------- ML: descriptive risk thresholds (must be approved before operational use) ----------
AFP_RISK_WINDOW_DAYS=7
AFP_RISK_RECENCY_HOURS=48
AFP_RISK_MIN_READINGS=36
AFP_RISK_ELEVATED_ANOMALY_COUNT=3
AFP_RISK_HIGH_ANOMALY_COUNT=10
AFP_RISK_ELEVATED_RATE_MULTIPLIER=2.0
AFP_RISK_HIGH_RATE_MULTIPLIER=5.0

# ---------- ML: artifacts ----------
# Outside source control. Default when unset: %LOCALAPPDATA%\AircraftFailurePrediction\models
# AFP_MODEL_DIR=
